{
  "name": "@shuvi/plugin-optimize-hook-destructuring",
  "version": "0.1.0",
  "description": "SWC plugin that optimizes React hook destructuring patterns",
  "main": "swc_plugin_optimize_hook_destructuring.wasm",
  "scripts": {
    "prepack": "pnpm run build",
    "build": "cargo build --release -p swc_plugin_optimize_hook_destructuring --target wasm32-wasip1 && cp ../../target/wasm32-wasip1/release/swc_plugin_optimize_hook_destructuring.wasm .",
    "build:debug": "cargo build -p swc_plugin_optimize_hook_destructuring --target wasm32-wasip1 && cp ../../target/wasm32-wasip1/debug/swc_plugin_optimize_hook_destructuring.wasm .",
    "test": "pnpm run build && jest --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuvijs/shuvi.git",
    "directory": "rust-packages/swc-plugin-optimize-hook-destructuring"
  },
  "bugs": {
    "url": "https://github.com/shuvijs/shuvi/issues"
  },
  "author": "Michael Hsu <evenchange4@gmail.com>",
  "keywords": ["swc", "plugin", "react", "hooks", "optimization"],
  "preferUnplugged": true,
  "devDependencies": {
    "@swc/core": "^1.12.7"
  }
} 