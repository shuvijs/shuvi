{
  "name": "@shuvi/plugin-auto-css-modules",
  "version": "0.1.0",
  "description": "SWC plugin that automatically transforms CSS imports to enable CSS modules",
  "main": "swc_plugin_auto_css_modules.wasm",
  "scripts": {
    "prepack": "pnpm run build",
    "build": "cargo build --release -p swc_plugin_auto_css_modules --target wasm32-wasip1 && cp ../../target/wasm32-wasip1/release/swc_plugin_auto_css_modules.wasm .",
    "build:debug": "cargo build -p swc_plugin_auto_css_modules --target wasm32-wasip1 && cp ../../target/wasm32-wasip1/debug/swc_plugin_auto_css_modules.wasm .",
    "test": "pnpm run build && jest --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuvijs/shuvi.git",
    "directory": "rust-packages/swc-plugin-auto-css-modules"
  },
  "bugs": {
    "url": "https://github.com/shuvijs/shuvi/issues"
  },
  "author": "Michael Hsu <evenchange4@gmail.com>",
  "keywords": ["swc", "plugin", "css", "modules", "auto"],
  "preferUnplugged": true,
  "devDependencies": {
    "@swc/core": "^1.12.7"
  }
} 