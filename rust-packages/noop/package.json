{
  "private": true,
  "name": "@shuvi/plugin-noop",
  "version": "0.1.0",
  "description": "SWC plugin that does nothing but prints when enabled",
  "main": "swc_plugin_noop.wasm",
  "scripts": {
    "prepack": "pnpm run build",
    "build": "cargo build --release -p swc_plugin_noop --target wasm32-wasip1 && cp ../../target/wasm32-wasip1/release/swc_plugin_noop.wasm .",
    "build:debug": "cargo build -p swc_plugin_noop --target wasm32-wasip1 && cp ../../target/wasm32-wasip1/debug/swc_plugin_noop.wasm .",
    "test": "pnpm run build:debug && vitest run --testTimeout=0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuvijs/shuvi.git",
    "directory": "rust-packages/noop"
  },
  "bugs": {
    "url": "https://github.com/shuvijs/shuvi/issues"
  },
  "author": "Michael Hsu <evenchange4@gmail.com>",
  "keywords": ["swc", "plugin", "noop"],
  "preferUnplugged": true,
  "dependencies": {
    "@swc/counter": "^0.1.3"
  }
} 