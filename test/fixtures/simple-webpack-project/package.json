{
  "private": true,
  "name": "simple-webpack-project",
  "version": "1.0.0",
  "scripts": {
    "clean": "rm -rf dist .cache",
    "build:webpack": "pnpm clean && webpack --config webpack.config.js",
    "build:rspack": "pnpm clean && rspack build --config rspack.config.js"
  },
  "devDependencies": {
    "webpack": "5.73.0",
    "webpack-cli": "^5.1.4",
    "webpack-chain": "6.5.1",
    "@shuvi/toolpack": "workspace:*",
    "rspack-chain": "^1.2.5",
    "@rspack/cli": "^1.3.15",
    "@rspack/core": "^1.4.0",
    "@rspack/plugin-html": "^0.5.8",
    "@rspack/plugin-react-refresh": "^1.4.3"
  }
} 