    "@rspack/plugin-react-refresh": "^1.4.3",
    "@shuvi/toolpack": "workspace:*",
    "@types/react": "18.0.9",
    "@types/react-dom": "18.0.6",
    "rspack-chain": "^1.2.6",
    "webpack": "5.73.0",
    "webpack-chain": "6.5.1",
    "webpack-cli": "^5.1.4"
  }
}
